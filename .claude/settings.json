{
  "permissions": {
    "deny": [
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/.env)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/key.properties)",
      "Read(**/secrets.dart)"
    ],
    "allow": [
      "Bash(dart analyze*)",
      "Bash(dart format *)",
      "Bash(dart run *)",
      "Bash(flutter --version)",
      "Bash(flutter analyze*)",
      "Bash(flutter build *)",
      "Bash(flutter devices)",
      "Bash(flutter pub *)",
      "Bash(flutter run*)",
      "Bash(flutter test*)"
    ]
  }
}
